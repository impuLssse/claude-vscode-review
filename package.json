      },
      {
        "language": "claude-review-ini",
        "scopeName": "source.claude-review-ini",
        "path": "./syntaxes/claude-review-ini.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test out/test/*.test.js",
    "format": "prettier --write .",
    "package": "npm test && vsce package -o diff-inline.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^3.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0"
  }
}
