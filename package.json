{
  "name": "diff-inline",
  "displayName": "Diff Inline (Cursor Based)",
  "description": "Cursor-style review of Claude Code edits right in the file: old lines in red, new in green, Accept / Reject for every change. Unofficial, not affiliated with Anthropic.",
  "version": "0.7.0",
  "publisher": "impuLssse",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1f2328",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/impuLssse/claude-vscode-review.git"
  },
  "bugs": {
    "url": "https://github.com/impuLssse/claude-vscode-review/issues"
  },
  "homepage": "https://github.com/impuLssse/claude-vscode-review#readme",
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude code",
    "review",
    "diff",
    "accept",
    "reject",
    "inline diff",
    "ai"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeReview.next",
        "category": "Diff Inline",
        "title": "следующая правка"
      },
      {
        "command": "claudeReview.list",
        "category": "Diff Inline",
        "title": "файлы с правками"
      },
      {
        "command": "claudeReview.undo",
        "category": "Diff Inline",
        "title": "отменить последний Accept / Reject"
      },
      {
        "command": "claudeReview.openFile",
        "category": "Diff Inline",
        "title": "открыть сам файл"
      },
      {
        "command": "claudeReview.show",
        "category": "Diff Inline",
        "title": "открыть ревью"
      },
      {
        "command": "claudeReview.acceptHunk",
        "category": "Diff Inline",
        "title": "принять правку",
        "icon": "$(check)"
      },
      {
        "command": "claudeReview.rejectHunk",
        "category": "Diff Inline",
        "title": "отклонить правку",
        "icon": "$(close)"
      },
      {
        "command": "claudeReview.acceptFile",
        "category": "Diff Inline",
        "title": "принять весь файл",
        "icon": "$(check)"
      },
      {
        "command": "claudeReview.rejectFile",
        "category": "Diff Inline",
        "title": "отклонить весь файл",
        "icon": "$(close)"
      },
      {
        "command": "claudeReview.acceptAll",
        "category": "Diff Inline",
        "title": "принять все правки",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeReview.viewAsTree",
        "category": "Diff Inline",
        "title": "показать деревом папок",
        "icon": "$(list-tree)"
      },
      {
        "command": "claudeReview.viewAsList",
        "category": "Diff Inline",
        "title": "показать списком",
        "icon": "$(list-flat)"
      },
      {
        "command": "claudeReview.rejectAll",
        "category": "Diff Inline",
        "title": "отклонить все правки",
        "icon": "$(close-all)"
      },
      {
        "command": "claudeReview.connectHook",
        "category": "Diff Inline",
        "title": "подключить к Claude Code"
      },
      {
        "command": "claudeReview.disconnectHook",
        "category": "Diff Inline",
        "title": "отключить от Claude Code"
      }
    ],
    "views": {
      "claude-sidebar-secondary": [
        {
          "id": "claudeReview.changes",
          "name": "Правки Claude",
          "when": "!claude-code:doesNotSupportSecondarySidebar"
        }
      ],
      "claude-sidebar": [
        {
          "id": "claudeReview.changesSidebar",
          "name": "Правки Claude",
          "when": "claude-code:doesNotSupportSecondarySidebar"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeReview.viewAsTree",
          "group": "navigation@0",
          "when": "view =~ /^claudeReview\\.changes/ && !claudeReview.treeMode"
        },
        {
          "command": "claudeReview.viewAsList",
          "group": "navigation@0",
          "when": "view =~ /^claudeReview\\.changes/ && claudeReview.treeMode"
        },
        {
          "command": "claudeReview.rejectAll",
          "group": "navigation@1",
          "when": "view =~ /^claudeReview\\.changes/"
        },
        {
          "command": "claudeReview.acceptAll",
          "group": "navigation@2",
          "when": "view =~ /^claudeReview\\.changes/"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeReview.rejectFile",
          "group": "inline@1",
          "when": "view =~ /^claudeReview\\.changes/ && viewItem == file"
        },
        {
          "command": "claudeReview.acceptFile",
          "group": "inline@2",
          "when": "view =~ /^claudeReview\\.changes/ && viewItem == file"
        },
        {
          "command": "claudeReview.rejectHunk",
          "group": "inline@1",
          "when": "view =~ /^claudeReview\\.changes/ && viewItem == hunk"
        },
        {
          "command": "claudeReview.acceptHunk",
          "group": "inline@2",
          "when": "view =~ /^claudeReview\\.changes/ && viewItem == hunk"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeReview.show",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "key": "alt+y",
        "command": "claudeReview.acceptHunk",
        "when": "editorTextFocus && resourceScheme == claude-review"
      },
      {
        "key": "alt+n",
        "command": "claudeReview.rejectHunk",
        "when": "editorTextFocus && resourceScheme == claude-review"
      },
      {
        "key": "alt+shift+y",
        "command": "claudeReview.acceptFile",
        "when": "editorTextFocus && resourceScheme == claude-review"
      },
      {
        "key": "alt+shift+n",
        "command": "claudeReview.rejectFile",
        "when": "editorTextFocus && resourceScheme == claude-review"
      },
      {
        "key": "ctrl+z",
        "mac": "cmd+z",
        "command": "claudeReview.undo",
        "when": "editorTextFocus && resource in claudeReview.undoResources"
      },
      {
        "key": "alt+j",
        "command": "claudeReview.next",
        "when": "editorTextFocus"
      }
    ],
    "languages": [
      {
        "id": "claude-review-typescript",
        "aliases": [
          "typescript (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-typescriptreact",
        "aliases": [
          "typescriptreact (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-javascript",
        "aliases": [
          "javascript (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-javascriptreact",
        "aliases": [
          "javascriptreact (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-json",
        "aliases": [
          "json (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-jsonc",
        "aliases": [
          "jsonc (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-python",
        "aliases": [
          "python (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-go",
        "aliases": [
          "go (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-yaml",
        "aliases": [
          "yaml (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-shellscript",
        "aliases": [
          "shellscript (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-sql",
        "aliases": [
          "sql (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-markdown",
        "aliases": [
          "markdown (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-css",
        "aliases": [
          "css (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-scss",
        "aliases": [
          "scss (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-html",
        "aliases": [
          "html (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-dockerfile",
        "aliases": [
          "dockerfile (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-dockercompose",
        "aliases": [
          "dockercompose (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-makefile",
        "aliases": [
          "makefile (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-vue",
        "aliases": [
          "vue (Diff Inline)"
        ]
      },
      {
        "id": "claude-review-ini",
        "aliases": [
          "ini (Diff Inline)"
        ]
      }
    ],
    "grammars": [
      {
        "language": "claude-review-typescript",
        "scopeName": "source.claude-review-typescript",
        "path": "./syntaxes/claude-review-typescript.tmLanguage.json"
      },
      {
        "language": "claude-review-typescriptreact",
        "scopeName": "source.claude-review-typescriptreact",
        "path": "./syntaxes/claude-review-typescriptreact.tmLanguage.json"
      },
      {
        "language": "claude-review-javascript",
        "scopeName": "source.claude-review-javascript",
        "path": "./syntaxes/claude-review-javascript.tmLanguage.json"
      },
      {
        "language": "claude-review-javascriptreact",
        "scopeName": "source.claude-review-javascriptreact",
        "path": "./syntaxes/claude-review-javascriptreact.tmLanguage.json"
      },
      {
        "language": "claude-review-json",
        "scopeName": "source.claude-review-json",
        "path": "./syntaxes/claude-review-json.tmLanguage.json"
      },
      {
        "language": "claude-review-jsonc",
        "scopeName": "source.claude-review-jsonc",
